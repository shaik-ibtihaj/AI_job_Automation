# Python virtual environment and bytecode
.venv/
__pycache__/
*.py[cod]

# Secrets and local environment configuration
.env
.env.*

# Local databases and their journal files
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Private resumes, application data, and generated output
/resumes/*
!/resumes/.gitkeep
/data/*
!/data/.gitkeep
/output/*
!/output/.gitkeep

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Private artifacts outside the standard storage folders
**/master_resume.pdf
**/candidate_profile.json
**/resume_extraction.json
**/resume_text.*
/applications/
/application_records/
/secrets/
*.pem
*.key
